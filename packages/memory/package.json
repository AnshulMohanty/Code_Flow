{
  "name": "@codeflow/memory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter @codeflow/config build && pnpm --filter @codeflow/shared-types build",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "pnpm --filter @codeflow/config build && pnpm --filter @codeflow/shared-types build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @codeflow/config build && pnpm --filter @codeflow/shared-types build",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@codeflow/config": "workspace:*",
    "@codeflow/shared-types": "workspace:*"
  }
}

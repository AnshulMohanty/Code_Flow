    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@codeflow/config": "workspace:*",
    "@codeflow/shared-types": "workspace:*",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph-2d": "^1.29.1",
    "vite": "^5.4.11",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^29.1.1"
  }
}

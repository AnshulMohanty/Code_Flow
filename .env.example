# CodeFlow — runtime environment (NAMES ONLY; never commit real values).
# Copy to `.env` at the REPO ROOT for local dev (every app loads it from there), or set these on the
# host (Render → Environment). Never bake them into an image.
#
# HOW TO READ THIS FILE. There are three groups:
#   1. REQUIRED  — the 12 a hosted demo needs (Render free + Atlas + Neon + Upstash + an OpenAI key).
#   2. OPTIONAL  — sensible defaults exist; set one only to change that default.
#   3. ADVANCED  — other AI vendors, tracing, the MCP server, evals, local tooling. A demo needs none.
# Leaving an optional or advanced variable empty is always safe.

# ════════════════════════════════════════════════════════════════════════════════════════════════
# 1. REQUIRED for a hosted demo
# ════════════════════════════════════════════════════════════════════════════════════════════════
NODE_ENV=                 # production on a host; development locally
MONGO_URI=                # analyses + caches. Local: mongodb://localhost:27017/codeflow · Atlas SRV URI in prod.
                          # A free Atlas cluster PAUSES after weeks with no connections; resume it in Atlas.
REDIS_URL=                # queue, rate limits, daily budget. Local: redis://localhost:6379.
                          # Upstash: the TCP URL with ?family=0 appended, e.g. rediss://default:<pw>@<host>:6379?family=0
POSTGRES_URL=             # pgvector Q&A index (Neon in prod). Unset = a per-process in-memory index.
CORS_ORIGINS=             # the website's URL, e.g. https://code-flow-1.onrender.com (comma-separate several)
TRUST_PROXY_HOPS=         # 1 on Render (one proxy hop). Without it every visitor shares one rate-limit bucket.
RUN_WORKER_IN_PROCESS=    # true = the analysis worker runs inside the API process (one free service)
MAX_REPO_FILES=           # refuse bigger repos (default 25000). Size to memory: ≈150 MiB + 30 KiB per file per job.
                          # A 512 MB instance: 3000.
OPENAI_API_KEY=           # the AI key. Unset = the server runs in "map only" mode (no AI, nothing spent).
LLM_PROVIDER=             # openai — names the chat vendor (required when more than one key is set)
EMBEDDING_PROVIDER=       # openai — names the embeddings vendor (same rule)
VITE_API_BASE_URL=        # WEBSITE BUILD only: the API's public URL, baked in at build time
                          # (e.g. https://code-flow-8r09.onrender.com, no trailing slash). Local default: http://localhost:4000

# ════════════════════════════════════════════════════════════════════════════════════════════════
# 2. OPTIONAL — cost control and sizing (strongly suggested on a small prepaid AI budget)
# ════════════════════════════════════════════════════════════════════════════════════════════════
OPENAI_MODEL=             # chat model; default gpt-4.1-mini ($0.40 in / $1.60 out per 1M tokens, OpenAI 2026-11-25).
                          # o-series reasoning models are not supported (they reject temperature 0).
OPENAI_EMBEDDING_MODEL=   # default text-embedding-3-small ($0.02 per 1M tokens, 1536 dims)
OPENAI_EMBEDDING_DIM=     # unset = the model's native width (it names the pgvector table; see the note at the end)
DAILY_LLM_BUDGET=         # chat tokens allowed per UTC day across ALL visitors (default 5000000).
                          # e.g. 400000 ≈ $0.25/day on gpt-4.1-mini at a typical 85/15 input/output mix.
DAILY_EMBEDDING_BUDGET=   # embedding tokens per UTC day (default 5000000 ≈ $0.10/day on 3-small)
DAILY_AI_ANALYSES_PER_IP= # new AI analyses one visitor may start per UTC day (unset = no cap). "Map only" is never capped.
DAILY_QUESTIONS_PER_IP=   # questions one visitor may ask per UTC day (unset = no cap)
LLM_PRICING=              # JSON price table so runs show dollars, not "—". Prices are NOT built in (they change);
                          # unset = tokens are still measured, the dollar figure is reported as unknown. e.g.
                          # {"gpt-4.1-mini":{"inputPerMillion":0.4,"outputPerMillion":1.6,"cacheReadPerMillion":0.1},
                          #  "text-embedding-3-small":{"inputPerMillion":0.02,"outputPerMillion":0}}
MAX_INDEX_CHUNKS=         # Q&A index cap per analysis (unset = none). 4000 keeps a 512 MB host safe (measured:
                          # 2,811-file repo → 316 MiB peak); over it, the most connected files are indexed first.
EMBEDDING_CACHE=          # false = no per-chunk embedding copy in Mongo (vectors already live in Postgres).
                          # Default on; turn off on a free 512 MB Atlas cluster.
MAX_REPO_BYTES=           # the size cap in bytes (default 536870912, 512 MB)
CODEFLOW_GIT_TIMEOUT_MS=  # per-clone timeout (default 120000)
GIT_SHA=                  # build id shown in the footer (fallback SOURCE_COMMIT). Unset = "—".
SOURCE_COMMIT=

# ════════════════════════════════════════════════════════════════════════════════════════════════
# 3. ADVANCED — not needed for a demo
# ════════════════════════════════════════════════════════════════════════════════════════════════
# ── Ports (a host sets PORT itself; never set API_PORT on Render — it wins over PORT and breaks routing)
API_PORT=                 # local default 4000
PORT=                     # set by the platform
WEB_PORT=                 # vite dev server port (default 5173)
API_BASE_URL=             # Docker web image only: written into /config.js at container start

# ── Other AI vendors. Chat and embeddings are chosen independently; any pairing works.
ANTHROPIC_API_KEY=        # LLM_PROVIDER=anthropic
GEMINI_API_KEY=           # LLM_PROVIDER / EMBEDDING_PROVIDER=gemini. Set ONE vendor's key per role, or name
VOYAGE_API_KEY=           # the provider: two keys and no LLM_PROVIDER is a startup error, by design.
SYNTHESIS_MODEL=          # Anthropic only (default claude-opus-4-8)
GEMINI_MODEL=             # default gemini-2.5-flash
VOYAGE_MODEL=             # default voyage-code-3
GEMINI_EMBEDDING_MODEL=   # default gemini-embedding-001
GEMINI_EMBEDDING_DIM=     # default 768

# ── Worker tuning (split API/worker deployments)
WORKER_CONCURRENCY=       # jobs per worker (default 2, max 8; forced to 1 when RUN_WORKER_IN_PROCESS=true)
WORKER_HEALTH_PORT=       # opens /health /ready /metrics on the worker (the image sets 4100)
CODEFLOW_TMP_DIR=         # clone directory (default: OS tmp)
CODEFLOW_KEEP_TMP=        # true keeps clones (debugging)
ANALYZER_VERSION=         # cache namespace override; the real one is a constant in @codeflow/config

# ── Experimental flags (off by default, each for a stated reason in DESIGN.md)
FANOUT_SYNTHESIS=         # multi-agent onboarding guide: 5N+1 model calls instead of 1
PARALLEL_STAGES=          # overlap independent pipeline stages
SPECULATIVE_PREFETCH=     # build the Q&A chunk plan while synthesis waits
FAST_MODEL=               # a cheaper model for the fan-out's small calls

# ── MCP server (apps/mcp). DEFAULT-DENY: with no scopes it exposes nothing.
CODEFLOW_MCP_SCOPES=      # graph | retrieval | verify | all
CODEFLOW_MCP_RESULT=      # a saved AnalysisResult JSON to serve
CODEFLOW_MCP_API=         # ...or a running API, e.g. http://localhost:4000
CODEFLOW_MCP_JOB=         # ...and a job id on it

# ── Tracing exporters (off unless fully configured)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
HELICONE_API_KEY=
HELICONE_ENDPOINT=

# ── Scripts and evals (never read by a running service)
CODEFLOW_API_URL=         # deployed API URL for scripts/prewarm-demos.mjs and scripts/live-benchmark.mjs
EVAL_DATASET=
EVAL_FAIL_ON_THRESHOLD=

# ── THE EMBEDDING DIMENSION NAMES THE VECTOR TABLE ────────────────────────────────────────────────
# pgvector's vector(n) is fixed-width, so the table is codeflow_vectors_<dim>: openai 3-small 1536,
# gemini 768, voyage 1024. Switching embedding provider addresses a NEW table — nothing breaks, but
# the old index does not carry over: re-analyse a repository before asking questions about it.

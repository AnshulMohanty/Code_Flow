# CodeFlow — runtime environment (NAMES ONLY; never commit real values).
# Copy to .env at the REPO ROOT for local dev (this is the single source; every app loads it
# from here regardless of its own working dir), or inject these at container run-time (never
# baked into images).

# ── API (apps/api) ───────────────────────────────────────────────────────────
API_PORT=                 # default 4000 (the container EXPOSEs this)
MONGO_URI=                # e.g. mongodb://localhost:27017/codeflow (Atlas URI in prod)
REDIS_URL=                # e.g. redis://localhost:6379 (managed Redis in prod)
POSTGRES_URL=             # V3-P2 retrieval stores (pgvector + chunk text). Read by BOTH the
                          # api and the worker, and they MUST agree: the worker writes the
                          # Q&A index here and the api reads it.
                          # Dev: postgres://codeflow:codeflow@localhost:5432/codeflow
                          #      (the `postgres` service in docker-compose.yml).
                          # UNSET is a supported mode, not an error: the index falls back to
                          # per-process memory, which means the api can answer nothing the
                          # worker indexed. Both processes log that degradation at startup.
ANALYZER_VERSION=         # cache-key namespace; defaults to ANALYZER_VERSION in
                          # @codeflow/config (1.0.0). Override only for ad-hoc namespacing;
                          # bump the constant for a breaking analyzer change.
NODE_ENV=                 # development | production | test
CORS_ORIGINS=             # PROD only: comma-separated browser origins allowed for REST + SSE,
                          # e.g. https://app.codeflow.example. In dev the API auto-allows any
                          # origin on the Vite web port (WEB_PORT, default 5173).

# ── Worker (apps/worker) — same MONGO_URI / REDIS_URL, plus clone + AI config ──
CODEFLOW_TMP_DIR=         # where public repos are cloned (default: OS tmp/codeflow-public-repos)
CODEFLOW_KEEP_TMP=        # "true" to keep the cloned working tree (debug); default cleans up
CODEFLOW_MAX_FILES=       # clone-time file-count guard in the cloner (default 5000)
# AI provider selection (P12). Unset ⇒ inferred from whichever key is present; both keys set
# with no explicit provider ⇒ a clear startup error. A single GEMINI_API_KEY can power both.
FANOUT_SYNTHESIS=         # V3-P4: "true" to synthesize via the BOUNDED AGENT FAN-OUT (specialists
                          # over code communities + a supervisor) instead of one call. Default off
                          # because of cost SHAPE, not doubt: a fan-out is 5N+1 provider calls where
                          # the single-shot stage is 1 — right for a real onboarding guide, wrong for
                          # a demo on a free tier. Ignored when the analysis has no communities.
LLM_PROVIDER=             # anthropic | gemini
EMBEDDING_PROVIDER=       # voyage | gemini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
VOYAGE_API_KEY=
# Optional model overrides (sensible defaults applied):
SYNTHESIS_MODEL=          # default claude-opus-4-8 (anthropic)
GEMINI_MODEL=             # default gemini-2.5-flash
VOYAGE_MODEL=             # default voyage-code-3
GEMINI_EMBEDDING_MODEL=   # default gemini-embedding-001
GEMINI_EMBEDDING_DIM=     # default 768

# ── Web (apps/web) ─────────────────────────────────────────────────────────────
# RUNTIME-injected (NOT baked): the web image writes /config.js from API_BASE_URL at container
# start, so ONE image works across environments. VITE_API_BASE_URL is only a dev/build fallback.
API_BASE_URL=             # public base URL of the API, e.g. https://api.codeflow.example
VITE_API_BASE_URL=        # dev fallback only (default http://localhost:4000)
WEB_PORT=                 # vite dev server port (default 5173)

# NOTE: the P4 guardrail limits (MAX_FILES / MAX_BYTES / PARSE_CONCURRENCY / FILE_TIMEOUT_MS /
# RATE_* / DAILY_LLM_BUDGET / RAG_* / GRAPH_*) are compile-time constants in @codeflow/config
# today — not env vars. P7 may promote the operator-relevant ones to env. The same is true of
# the V3-P2 retrieval knobs (RETRIEVAL_* / BM25_* / RRF_K / MMR_LAMBDA), the V3-P3 agent + memory
# bounds (AGENT_MAX_* / SESSION_MAX_* / REPO_MAX_SNAPSHOTS) and the V3-P4 fan-out bounds
# (FANOUT_* / SPECIALIST_* / SUPERVISOR_* / BEST_OF_N / MAX_HARD_COMMUNITIES).

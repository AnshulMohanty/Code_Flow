# CodeFlow — runtime environment (NAMES ONLY; never commit real values).
# Copy to .env at the REPO ROOT for local dev (this is the single source; every app loads it
# from here regardless of its own working dir), or inject these at container run-time (never
# baked into images).

# ── API (apps/api) ───────────────────────────────────────────────────────────
API_PORT=                 # default 4000 (the container EXPOSEs this). EXPLICIT OPERATOR CHOICE,
                          # and it WINS over PORT below -- so do NOT set it on a managed host.
PORT=                     # SET BY THE PLATFORM, not by you (Render/Railway/Fly/Heroku assign the
                          # port at boot). The API binds 0.0.0.0 on API_PORT, else PORT, else 4000,
                          # and logs which one it used. Both set and disagreeing is a
                          # misconfiguration -- the platform's proxy routes to PORT -- so it is
                          # warned about at boot rather than resolved quietly.
MONGO_URI=                # e.g. mongodb://localhost:27017/codeflow (Atlas URI in prod)
REDIS_URL=                # e.g. redis://localhost:6379 (managed Redis in prod)
POSTGRES_URL=             # V3-P2 retrieval stores (pgvector + chunk text). Read by BOTH the
                          # api and the worker, and they MUST agree: the worker writes the
                          # Q&A index here and the api reads it.
                          # Dev: postgres://codeflow:codeflow@localhost:5432/codeflow
                          #      (the `postgres` service in docker-compose.yml).
                          # UNSET is a supported mode, not an error: the index falls back to
                          # per-process memory, which means the api can answer nothing the
                          # worker indexed. Both processes log that degradation at startup.
ANALYZER_VERSION=         # cache-key namespace; defaults to ANALYZER_VERSION in
                          # @codeflow/config (1.0.0). Override only for ad-hoc namespacing;
                          # bump the constant for a breaking analyzer change.
NODE_ENV=                 # development | production | test
CORS_ORIGINS=             # PROD only: comma-separated browser origins allowed for REST + SSE,
                          # e.g. https://app.codeflow.example. In dev the API auto-allows any
                          # origin on the Vite web port (WEB_PORT, default 5173).

# ── Worker (apps/worker) — same MONGO_URI / REDIS_URL, plus clone + AI config ──
CODEFLOW_TMP_DIR=         # where public repos are cloned (default: OS tmp/codeflow-public-repos)
CODEFLOW_KEEP_TMP=        # "true" to keep the cloned working tree (debug); default cleans up
CODEFLOW_MAX_FILES=       # clone-time file-count guard in the cloner (default 5000)
CODEFLOW_GIT_TIMEOUT_MS=  # per-clone timeout (default 120000). A repository that cannot be
                          # cloned inside it fails the job rather than holding a worker slot.
RUN_WORKER_IN_PROCESS=     # "true" runs the BullMQ consumer INSIDE the API process (free-tier
                          # single-service mode). Default false — the two-process split is the
                          # right shape for anything that scales. Forces concurrency to 1.
                          # See DEPLOY.md Appendix C and render.free.yaml.
WORKER_CONCURRENCY=       # jobs per worker instance (default 2, ceiling 8; out-of-range values
                          # are clamped and announced). Past the ceiling, scale OUT -- and
                          # autoscale on QUEUE DEPTH, never CPU: this process looks idle while it
                          # waits on a provider call, which is most of a run.
WORKER_HEALTH_PORT=       # binds the worker's /health /ready /metrics. UNSET => NO SOCKET IS
                          # OPENED, which is the default; the container image sets 4100. Set it
                          # before relying on a healthcheck or an autoscaler. `queueDepth: null`
                          # with `queueDepthAvailable: false` means Redis is unreadable -- do not
                          # read it as zero, which scales IN exactly when the backlog went blind.
# AI provider selection (P12). Unset ⇒ inferred from whichever key is present; both keys set
# with no explicit provider ⇒ a clear startup error. A single GEMINI_API_KEY can power both.
PARALLEL_STAGES=          # V3-P5: "true" to run independent pipeline stages CONCURRENTLY, scheduled
                          # by dependency readiness. On this DAG that overlaps `rag` (embedding)
                          # with `analyze`→`synthesize`, the two slowest stages. Opt-in because it
                          # touches the deterministic spine — the slices are proven byte-identical
                          # to the sequential run, but that is a different bar from being default.
FAST_MODEL=               # V3-P5 model routing: a cheap/fast model for the many small specialist
                          # calls (e.g. gemini-2.5-flash-lite, gpt-4.1-mini). Unset ⇒ ONE tier and
                          # the client is used unwrapped, so cache keys are unchanged. Built from
                          # the SELECTED provider when that is openai, else from GEMINI_API_KEY;
                          # the configured LLM_PROVIDER model stays the frontier tier.
FANOUT_SYNTHESIS=         # V3-P4: "true" to synthesize via the BOUNDED AGENT FAN-OUT (specialists
                          # over code communities + a supervisor) instead of one call. Default off
                          # because of cost SHAPE, not doubt: a fan-out is 5N+1 provider calls where
                          # the single-shot stage is 1 — right for a real onboarding guide, wrong for
                          # a demo on a free tier. Ignored when the analysis has no communities.
# CHAT and EMBEDDINGS are chosen INDEPENDENTLY. Any pairing works — OpenAI chat with Voyage
# embeddings, Anthropic chat with OpenAI embeddings — because each role is a separate variable
# reading a separate key. Unset ⇒ inferred from whichever key is present; MORE THAN ONE key with
# no explicit provider ⇒ a clear startup error rather than a guess about which vendor you pay.
LLM_PROVIDER=             # anthropic | gemini | openai
EMBEDDING_PROVIDER=       # voyage | gemini | openai
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
VOYAGE_API_KEY=
OPENAI_API_KEY=           # powers BOTH roles, like GEMINI_API_KEY — LLM_PROVIDER and
                          # EMBEDDING_PROVIDER still choose them one at a time.
# Optional model overrides (sensible defaults applied):
SYNTHESIS_MODEL=          # default claude-opus-4-8 (ANTHROPIC ONLY — not read for openai/gemini,
                          # because a claude model id sent to another vendor is a 404 that reads
                          # like an outage)
GEMINI_MODEL=             # default gemini-2.5-flash
VOYAGE_MODEL=             # default voyage-code-3
OPENAI_MODEL=             # default gpt-4.1. NOTE: the o-series reasoning models reject
                          # temperature 0, and temperature 0 is what makes a given SHA's analysis
                          # reproducible — so they are not a supported value here today.
GEMINI_EMBEDDING_MODEL=   # default gemini-embedding-001
GEMINI_EMBEDDING_DIM=     # default 768
OPENAI_EMBEDDING_MODEL=   # default text-embedding-3-small (1536). -3-large is 3072.
OPENAI_EMBEDDING_DIM=     # unset ⇒ the MODEL'S NATIVE width. Only truncates (the v3 models are
                          # Matryoshka-trained); text-embedding-ada-002 does not accept it.

# ── THE EMBEDDING DIMENSION IS NOT COSMETIC ───────────────────────────────────
# The vector index is pgvector, and pgvector's vector(n) is a FIXED-WIDTH type: one table cannot
# hold two embedding spaces. So the resolved dimension is part of the TABLE NAME —
# codeflow_vectors_<dim> — and ensureSchema() creates whichever one the current config names:
#
#   gemini  @ 768  (default) → codeflow_vectors_768
#   voyage  @ 1024 (default) → codeflow_vectors_1024
#   openai  @ 1536 (3-small) → codeflow_vectors_1536
#   openai  @ 3072 (3-large) → codeflow_vectors_3072
#
# A provider switch therefore CANNOT query the old table with the wrong-width vectors — it
# addresses a different table, and assertEmbeddingSpace refuses at the boundary if the two ever
# disagree. What it DOES mean is that the old index does not transfer: every repository has to be
# re-analysed in the new space before Q&A can answer about it again. The deterministic map is
# unaffected, and so is every analysis already stored in Mongo.

# ── MCP server (apps/mcp; V3-P5) ──────────────────────────────────────────────
# DEFAULT-DENY: with CODEFLOW_MCP_SCOPES unset, every tool is hidden and the server exposes nothing.
# That is deliberate — an MCP tool is invoked by a MODEL, so anything a tool can do a prompt-injected
# model can be talked into doing. Set scopes explicitly.
CODEFLOW_MCP_SCOPES=      # comma-separated: graph | retrieval | verify   (or "all")
                          #   graph     — exact, free, read-only code-graph lookups
                          #   retrieval — hybrid search; a query embedding is a PAID call
                          #   verify    — grade a claim with the Arena verifier (exact, free)
CODEFLOW_MCP_RESULT=      # path to a saved AnalysisResult JSON the tools operate on
CODEFLOW_MCP_API=         # ...or fetch one from a running API, e.g. http://localhost:4000
CODEFLOW_MCP_JOB=         # ...with this job id. The MCP server never RUNS an analysis itself:
                          # a remote model could otherwise spend the whole daily budget in one call.

# ── Observability (V3-P5; OPTIONAL, off unless fully configured) ──────────────
# Absent ⇒ NO exporter object exists and no code path can reach a network. That is what "off in
# tests" means here: not a no-op exporter, but nothing at all — so "observability is on" and
# "observability is configured" stay distinguishable. A partial config is treated as OFF.
LANGFUSE_HOST=            # e.g. https://cloud.langfuse.com  (needs BOTH keys below to activate)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
HELICONE_API_KEY=         # activates the Helicone exporter on its own
HELICONE_ENDPOINT=        # default https://api.helicone.ai/custom/v1/log
LLM_PRICING=              # JSON price table. UNSET => cost reports `usd: null` with the unpriced
                          # models NAMED, and the UI shows an em-dash. Tokens are MEASURED either
                          # way; only the dollar figure is missing. Not baked in on purpose:
                          # prices change per account and region, and a stale constant reports a
                          # confident wrong number where an empty table reports "we do not know".
                          # A malformed blob applies NO prices and logs why. Format:
                          # {"claude-sonnet-4-5":{"inputPerMillion":3,"outputPerMillion":15}}
GIT_SHA=                  # build id for /api/meta and the site footer. SOURCE_COMMIT is the
SOURCE_COMMIT=            # fallback. Unset => `null` and an em-dash, deliberately: a build id
                          # nobody can look up is decoration. On Render: RENDER_GIT_COMMIT.
# OpenTelemetry is an INJECTED adapter, not a dependency: install @opentelemetry/api + an SDK and
# pass `trace.getTracer("codeflow")` at the composition root. See GO_LIVE.md.

# ── Web (apps/web) ─────────────────────────────────────────────────────────────
# RUNTIME-injected (NOT baked): the web image writes /config.js from API_BASE_URL at container
# start, so ONE image works across environments. VITE_API_BASE_URL is only a dev/build fallback.
API_BASE_URL=             # public base URL of the API, e.g. https://api.codeflow.example
VITE_API_BASE_URL=        # dev fallback only (default http://localhost:4000)
WEB_PORT=                 # vite dev server port (default 5173)

# ── Scripts + eval (never needed by a running service) ──────────────────────────
CODEFLOW_API_URL=         # deployed API base URL, for scripts/prewarm-demos.mjs and
                          # scripts/live-benchmark.mjs (or pass the URL as argv[1]).
                          # NOT a keep-alive target: there is no scheduled pinger. See DEPLOY.md.
EVAL_DATASET=             # dataset id for the eval CLIs
EVAL_FAIL_ON_THRESHOLD=   # "true" to make the scored eval FAIL the run on a threshold miss.
                          # Defaults FALSE deliberately: the workflow publishes numbers so the
                          # thresholds can be calibrated FROM them. Flip it once they are real.

# NOTE: the P4 guardrail limits (MAX_FILES / MAX_BYTES / PARSE_CONCURRENCY / FILE_TIMEOUT_MS /
# RATE_* / DAILY_LLM_BUDGET / RAG_* / GRAPH_*) are compile-time constants in @codeflow/config
# today — not env vars. P7 may promote the operator-relevant ones to env. The same is true of
# the V3-P2 retrieval knobs (RETRIEVAL_* / BM25_* / RRF_K / MMR_LAMBDA), the V3-P3 agent + memory
# bounds (AGENT_MAX_* / SESSION_MAX_* / REPO_MAX_SNAPSHOTS) and the V3-P4 fan-out bounds
# (FANOUT_* / SPECIALIST_* / SUPERVISOR_* / BEST_OF_N / MAX_HARD_COMMUNITIES).
